---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
---

<BaseLayout title="高温FDM设备" sideBarActiveItemID="projects">
  <div class="max-w-3xl mx-auto">
    <div class="mb-4">
      <div class="text-3xl font-bold">大型高温FDM 3D打印设备研发</div>
      <div class="text-lg text-base-content/70 mt-1">
        Large-scale High-temperature FDM 3D Printer for PEEK and Advanced Polymers
      </div>
      <div class="mt-3 flex flex-wrap gap-2">
        <span class="badge badge-primary">进行中</span>
        <span class="badge badge-outline">STM32H7</span>
        <span class="badge badge-outline">Klipper</span>
        <span class="badge badge-outline">Linux</span>
        <span class="badge badge-outline">RK3588</span>
        <span class="badge badge-outline">EPLAN</span>
      </div>
    </div>

    <div class="divider"></div>

    <div class="mb-8">
      <h2 class="text-2xl font-bold mb-3">项目概述</h2>
      <p class="text-base-content/80 leading-relaxed">
        面向PEEK等高性能聚合物材料打印需求，自主设计搭建500×500×500mm大尺寸高温FDM 3D打印设备。
        基于Linux+RK3588与STM32H7构建分布式控制系统，实现多轴运动、温度闭环及挤出控制。
        使用EPLAN、嘉立创ECAD完成整机电气系统设计；二次开发Klipper/Moonraker打印控制系统。
      </p>
    </div>

    <div class="divider"></div>

    <div class="mb-8">
      <h2 class="text-2xl font-bold mb-3">设备实物</h2>
      <div class="card bg-base-100 shadow-lg">
        <div class="card-body">
          <Image
            src="/fig-device.jpg"
            alt="大型高温FDM 3D打印设备"
            width={800}
            height={600}
            format="webp"
            class="rounded-lg w-full"
          />
        </div>
      </div>
    </div>

    <div class="divider"></div>

    <div class="mb-8">
      <h2 class="text-2xl font-bold mb-3">技术参数</h2>
      <div class="overflow-x-auto">
        <table class="table table-zebra w-full">
          <thead>
            <tr>
              <th>参数</th>
              <th>规格</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>打印尺寸</td>
              <td>500 × 500 × 500 mm</td>
            </tr>
            <tr>
              <td>最高喷头温度</td>
              <td>450°C</td>
            </tr>
            <tr>
              <td>热床温度</td>
              <td>150°C</td>
            </tr>
            <tr>
              <td>主控制器</td>
              <td>RK3588 + Linux</td>
            </tr>
            <tr>
              <td>运动控制器</td>
              <td>STM32H7</td>
            </tr>
            <tr>
              <td>固件系统</td>
              <td>Klipper + Moonraker</td>
            </tr>
            <tr>
              <td>通信协议</td>
              <td>CAN/Modbus/RS485</td>
            </tr>
            <tr>
              <td>加热系统</td>
              <td>Phaetus Dragon Water Hotend</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="divider"></div>

    <div class="mb-8">
      <h2 class="text-2xl font-bold mb-3">系统架构</h2>
      <div class="card bg-base-100 shadow-lg">
        <div class="card-body">
          <div class="font-mono text-sm space-y-2">
            <div class="flex items-center gap-2">
              <span class="text-primary">RK3588 (Linux)</span>
              <span class="text-base-content/50">— 主控</span>
            </div>
            <div class="flex items-center gap-2 ml-4">
              <span class="text-secondary">├─</span>
              <span>Klipper + Moonraker — 打印控制</span>
            </div>
            <div class="flex items-center gap-2 ml-4">
              <span class="text-secondary">├─</span>
              <span>MPC/EKF — 温控算法</span>
            </div>
            <div class="flex items-center gap-2 ml-4">
              <span class="text-secondary">└─</span>
              <span>AI Agent — 智能切片</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-primary">STM32H7</span>
              <span class="text-base-content/50">— 运动控制</span>
            </div>
            <div class="flex items-center gap-2 ml-4">
              <span class="text-secondary">├─</span>
              <span>多轴运动控制</span>
            </div>
            <div class="flex items-center gap-2 ml-4">
              <span class="text-secondary">├─</span>
              <span>温度闭环</span>
            </div>
            <div class="flex items-center gap-2 ml-4">
              <span class="text-secondary">├─</span>
              <span>挤出控制</span>
            </div>
            <div class="flex items-center gap-2 ml-4">
              <span class="text-secondary">└─</span>
              <span>CAN/Modbus/RS485</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-primary">电气系统</span>
              <span class="text-base-content/50">— EPLAN + 嘉立创ECAD</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="divider"></div>

    <div class="mb-8">
      <h2 class="text-2xl font-bold mb-3">技术特点</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="card bg-base-100 shadow">
          <div class="card-body">
            <h3 class="card-title text-lg">分布式控制</h3>
            <p class="text-sm text-base-content/70">
              RK3588（Linux）负责高层计算与控制策略，STM32H7负责实时运动控制，二者通过CAN总线通信
            </p>
          </div>
        </div>
        <div class="card bg-base-100 shadow">
          <div class="card-body">
            <h3 class="card-title text-lg">Klipper二次开发</h3>
            <p class="text-sm text-base-content/70">
              基于Klipper/Moonraker生态进行深度定制开发，适配高温大尺寸打印需求
            </p>
          </div>
        </div>
        <div class="card bg-base-100 shadow">
          <div class="card-body">
            <h3 class="card-title text-lg">专业电气设计</h3>
            <p class="text-sm text-base-content/70">
              使用EPLAN和嘉立创ECAD完成整机电气系统设计，确保系统可靠性与安全性
            </p>
          </div>
        </div>
        <div class="card bg-base-100 shadow">
          <div class="card-body">
            <h3 class="card-title text-lg">高性能挤出</h3>
            <p class="text-sm text-base-content/70">
              采用Phaetus Dragon Water Hotend，支持450°C高温挤出，适配PEEK等高性能材料
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class="divider"></div>

    <div class="mb-8">
      <h2 class="text-2xl font-bold mb-3">相关资源</h2>
      <div class="flex flex-wrap gap-2">
        <a class="btn btn-sm btn-ghost" href="https://github.com/wangyh775/kalico" target="_blank" rel="noopener">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
          </svg>
          GitHub 仓库
        </a>
        <a class="btn btn-sm btn-ghost" href="/projects">← 返回项目列表</a>
      </div>
    </div>
  </div>
</BaseLayout>