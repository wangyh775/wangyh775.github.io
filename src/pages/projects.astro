---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout title="项目" sideBarActiveItemID="projects">
  <div>
    <div class="text-3xl w-full font-bold mb-5">科研与工程实践</div>
  </div>

  <HorizontalCard
    title="JHTracker — AI 驱动的求职全流程管理"
    img="/fig-project-jhtracker.svg"
    desc="Flask + SQLAlchemy + MCP 构建的 Agent-Native 求职管理工具，36 个 MCP 工具覆盖 11 个数据域，实现 HITL 人机协同决策闭环与 Agent Trace 实时轨迹可视化。OpenSpec 驱动开发，含完整测试与迁移。"
    url="/projects/jhtracker"
    target="_self"
    badge="开源"
    tags={["Flask", "MCP", "AI Agent", "HITL", "SQLite"]}
  />
  <div class="divider my-0"></div>

  <HorizontalCard
    title="大型高温FDM 3D打印设备研发"
    img="/fig-hardware-topology.gif"
    desc="面向PEEK等高性能材料打印需求，自主设计搭建500×500×500mm大尺寸高温FDM 3D打印设备。基于Linux+RK3588与STM32H7构建分布式控制系统，实现多轴运动、温度闭环及挤出控制。使用EPLAN、嘉立创ECAD完成整机电气系统设计；二次开发Klipper/Moonraker打印控制系统。"
    url="/projects/fdm-hardware"
    target="_self"
    badge="进行中"
    tags={["STM32H7", "Klipper", "Linux", "RK3588"]}
  />
  <div class="divider my-0"></div>

  <HorizontalCard
    title="FDM挤出机热端MPC温控方法"
    img="/fig-hotend-schematic.png"
    desc="针对高速打印中热端温度波动大、PID响应滞后的问题，设计基于模型预测控制（MPC）的热端温控系统，使用EKF实现温度状态估计，部署于嵌入式平台，实现加热功率实时优化控制。已发表EI论文（ERX，IF 1.8，JCR Q2）。"
    url="/projects/mpc-thermal-control"
    target="_self"
    badge="已发表"
    tags={["MPC", "EKF", "嵌入式"]}
  />
  <div class="divider my-0"></div>

  <HorizontalCard
    title="基于AI Agent的智能切片系统"
    img="/fig-software-diagram.png"
    desc="基于OrcaSlicer源码级二次开发，集成LangGraph多智能体系统，重构切片工作流，实现打印工艺参数推荐与实时优化。"
    url="/projects/ai-agent-slicer"
    target="_self"
    badge="开源"
    tags={["LangGraph", "OrcaSlicer", "Python", "AI Agent"]}
  />
  <div class="divider my-0"></div>

  <HorizontalCard
    title="面向PEEK的高温FDM喷头流热耦合仿真"
    img="/fig-cfd-simulation.png"
    desc="建立高温FDM热端热流固耦合CFD模型，分析喷头内部传热及流动阻力。搭建高温挤出推力测试平台验证（误差<2%），基于响应面法优化并确定最佳工艺窗口。"
    url="/projects/peek-cfd-simulation"
    target="_self"
    tags={["COMSOL", "CFD", "响应面法"]}
  />
</BaseLayout>

<script>
  // 保存滚动位置（离开页面时）
  window.addEventListener("scroll", () => {
    sessionStorage.setItem("projects_scroll", window.scrollY);
  });

  // 页面加载完成后恢复滚动位置
  document.addEventListener("DOMContentLoaded", () => {
    const saved = sessionStorage.getItem("projects_scroll");
    if (saved) {
      window.scrollTo({ top: parseInt(saved, 10), behavior: "instant" });
    }
  });

  // 图片加载完成后再次校准，确保位置准确
  window.addEventListener("load", () => {
    const saved = sessionStorage.getItem("projects_scroll");
    if (saved) {
      window.scrollTo({ top: parseInt(saved, 10), behavior: "instant" });
    }
  });
</script>