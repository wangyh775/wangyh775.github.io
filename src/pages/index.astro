---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-4 mt-5">
    <div class="text-5xl font-bold">王云鹤</div>
    <div class="text-3xl py-3 font-bold">机械工程硕士 · 大连交通大学</div>

    <!-- 一句话研究定位 -->
    <div class="py-3">
      <div class="text-xl font-semibold text-primary">
        构建面向高性能材料的智能增材制造系统<br class="sm:hidden" />
        <span class="text-base font-normal text-base-content/70">——从硬件设计、热控算法到AI驱动的工艺优化</span>
      </div>
    </div>

    <!-- 研究兴趣列表 -->
    <div class="mt-4 flex flex-wrap gap-3">
      <span class="badge badge-lg badge-outline py-3 px-4">高温FDM 3D打印 &amp; PEEK高性能材料</span>
      <span class="badge badge-lg badge-outline py-3 px-4">嵌入式控制 &amp; MPC/EKF算法</span>
      <span class="badge badge-lg badge-outline py-3 px-4">智能制造 &amp; AI Agent系统</span>
    </div>

    <div class="mt-8 flex flex-wrap gap-2">
      <a class="btn btn-sm btn-ghost" href="https://github.com/wangyh775" target="_blank" rel="noopener">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
        </svg>
        GitHub
      </a>
      <a class="btn btn-sm btn-ghost" href="https://blog.csdn.net/m0_58988991" target="_blank" rel="noopener">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
          <polyline points="14 2 14 8 20 8"/>
          <line x1="8" y1="13" x2="16" y2="13"/>
          <line x1="8" y1="17" x2="16" y2="17"/>
        </svg>
        CSDN
      </a>
      <a class="btn btn-sm btn-ghost" href="mailto:877660224@qq.com">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
          <polyline points="22,6 12,13 2,6"/>
        </svg>
        邮箱
      </a>
      <a class="btn btn-sm btn-ghost" href="/resume.pdf" download>
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="7 10 12 15 17 10"/>
          <line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
        下载简历
      </a>
    </div>

    <div class="mt-6 stats stats-vertical sm:stats-horizontal shadow bg-base-100">
      <div class="stat">
        <div class="stat-title">EI 论文</div>
        <div class="stat-value text-2xl">1 篇</div>
        <div class="stat-desc">ERX, IF 1.8, JCR Q2</div>
      </div>
      <div class="stat">
        <div class="stat-title">发明专利</div>
        <div class="stat-value text-2xl">1 项</div>
        <div class="stat-desc">已公开</div>
      </div>
      <div class="stat">
        <div class="stat-title">自研设备</div>
        <div class="stat-value text-2xl">500³mm</div>
        <div class="stat-desc">高温 FDM 3D 打印</div>
      </div>
      <div class="stat">
        <div class="stat-title">开源项目</div>
        <div class="stat-value text-2xl">2 个</div>
        <div class="stat-desc">JHTracker, Agent-Native</div>
      </div>
    </div>
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-2 mt-10">开源 / 工程实践</div>
  </div>

  <HorizontalCard
    title="JHTracker — AI 驱动的求职全流程管理"
    img="/post_img.webp"
    desc="Flask + SQLAlchemy + MCP 构建的 Agent-Native 求职管理工具，36 个 MCP 工具覆盖 11 个数据域，实现 HITL 人机协同决策闭环与 Agent Trace 实时轨迹可视化。OpenSpec 驱动开发，含完整测试与迁移。"
    url="https://github.com/wangyh775/JHTracker"
    badge="开源"
    tags={["Flask", "MCP", "AI Agent", "HITL", "SQLite"]}
  />

  <div>
    <div class="text-3xl w-full font-bold mb-2 mt-10">代表性项目</div>
  </div>

  <HorizontalCard
    title="大型高温FDM 3D打印设备研发"
    img="/fig-device.jpg"
    desc="面向PEEK等高性能材料，自主设计搭建500×500×500mm大尺寸高温FDM 3D打印设备。基于Linux+RK3588与STM32H7构建分布式控制系统，完成整机电气系统设计与Klipper/Moonraker固件二次开发。"
    url="/projects/fdm-hardware"
    tags={["STM32H7", "Klipper", "Linux", "RK3588"]}
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="FDM挤出机热端MPC温控方法"
    img="/fig-control-framework.png"
    desc="针对高速打印中热端温度波动大、PID响应滞后的问题，设计基于模型预测控制（MPC）的热端温控系统，使用EKF实现温度状态估计，部署于嵌入式平台。"
    url="/projects/mpc-thermal-control"
    tags={["MPC", "EKF", "嵌入式"]}
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="基于AI Agent的智能切片系统"
    img="/post_img.webp"
    desc="基于OrcaSlicer集成LangGraph多智能体系统，重构切片工作流，实现打印工艺参数推荐与实时优化。"
    url="/projects/ai-agent-slicer"
    badge="进行中"
    tags={["LangGraph", "OrcaSlicer", "Python"]}
  />
</BaseLayout>